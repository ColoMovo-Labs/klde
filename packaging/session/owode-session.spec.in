Name: owode-session
Version: @VERSION@
Release: @RELEASE@
Summary: Experimental owoDE KWin Wayland login session
License: GPL-3.0-or-later
URL: https://github.com/ColoMovo-Labs/klde
BuildArch: noarch
Source0: start-owode
Source1: owode-session-client
Source2: owode.desktop
Source3: LICENSE
Source4: org.owode.GnomeSettings.desktop
Source5: pam-kde
Source6: pam-kde-fingerprint
Source7: pam-kde-smartcard
Source8: owode-input-method
Requires: klde-shell-preview = @VERSION@-@RELEASE@
Requires: kwin >= 6.6
Requires: layer-shell-qt >= 6.6
Requires: kscreenlocker >= 6.6
Requires: plasma-workspace-libs >= 6.6
Requires: xorg-x11-server-Xwayland
Requires: dbus-daemon
Requires: dbus-tools
Requires: fcitx5 >= 5.1.19
Recommends: fcitx5-chinese-addons
Recommends: fcitx5-configtool
Requires: bash
Requires: pam
Requires: /etc/pam.d/password-auth

%description
An opt-in Wayland session entry and launcher for owo Desktop Environment.
Installs alongside existing sessions and does not change the display manager,
autologin, or the default session. This is a development snapshot, not a claim
of production readiness. Plasma Shell is not required.

%prep
%setup -q -c -T
cp -p %{SOURCE0} %{SOURCE1} %{SOURCE2} %{SOURCE3} %{SOURCE4} .

%build
# Scripts and metadata only. The matching shell is built separately in cloud CI.

%install
install -Dm755 start-owode %{buildroot}%{_bindir}/start-owode
install -Dm755 owode-session-client %{buildroot}%{_libexecdir}/owode-session-client
install -Dm755 %{SOURCE8} %{buildroot}%{_libexecdir}/owode-input-method
install -Dm644 owode.desktop %{buildroot}%{_datadir}/wayland-sessions/owode.desktop
install -Dm644 org.owode.GnomeSettings.desktop %{buildroot}%{_datadir}/applications/org.owode.GnomeSettings.desktop
# Linux-PAM's vendor directory is /usr/lib/pam.d even on x86_64, not lib64.
# A distribution/administrator policy under /etc/pam.d always takes priority.
install -Dm644 %{SOURCE5} %{buildroot}%{_prefix}/lib/pam.d/kde
install -Dm644 %{SOURCE6} %{buildroot}%{_prefix}/lib/pam.d/kde-fingerprint
install -Dm644 %{SOURCE7} %{buildroot}%{_prefix}/lib/pam.d/kde-smartcard

%files
%license LICENSE
%{_bindir}/start-owode
%{_libexecdir}/owode-session-client
%{_libexecdir}/owode-input-method
%{_datadir}/wayland-sessions/owode.desktop
%{_datadir}/applications/org.owode.GnomeSettings.desktop
%{_prefix}/lib/pam.d/kde
%{_prefix}/lib/pam.d/kde-fingerprint
%{_prefix}/lib/pam.d/kde-smartcard
