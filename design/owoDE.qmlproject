import QmlProject 1.1
Project {
    mainFile: "Preview.qml"
    mainUiFile: "scenes/Desktop.ui.qml"
    qt6Project: true
    qtForMCUs: false
    importPaths: ["."]
    QmlFiles { directory: "." }
    ImageFiles { directory: "../assets"; filter: "*.png;*.svg" }
    Files { directory: "../assets/fonts"; filter: "*.otf;*.ttf" }
    Environment { QT_QUICK_CONTROLS_STYLE: "Basic" }
}
