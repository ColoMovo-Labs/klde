{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "ci",
      "displayName": "CircleCI authoritative build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "ON",
        "OWODE_REQUIRE_SYSTEM_APPLICATIONS": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "ci", "configurePreset": "ci"}
  ],
  "testPresets": [
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {"outputOnFailure": true},
      "execution": {"noTestsAction": "error", "timeout": 30}
    }
  ]
}
